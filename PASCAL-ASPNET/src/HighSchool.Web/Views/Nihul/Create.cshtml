@using HighSchool.Web.Modules.Nihul
@model HighSchool.Web.Controllers.LedgerEntryForm
@{
    var type = TransactionTypes.Find(Model.Type)!;
    var prev = ViewData["Previous"] as LedgerEntry;
    ViewData["Title"] = type.Name;
}
<div class="page-title">
    <h1>@type.Name <span class="chip">@type.Letter</span></h1>
    <span class="origin @(type.IsCredit ? "text-success" : "text-danger")">@(type.IsCredit ? "זכות (+)" : "חובה (−)")</span>
</div>

<div class="panel" style="max-width: 44rem">
    <table class="table table-sm table-dos">
        <thead><tr><th></th><th>קוד</th><th>סכום</th><th>תאריך</th><th>ת. ערך</th><th>יתרה</th></tr></thead>
        <tbody>
            <tr>
                <th>קודם</th>
                @if (prev is null)
                {
                    <td colspan="5" class="text-muted">אין פעולות</td>
                }
                else
                {
                    <td class="num">@(prev.Code?.ToString() ?? "---")</td>
                    <td class="num">@prev.Amount.ToString("N1")</td>
                    <td class="num">@prev.Date.ToString("dd/MM/yy")</td>
                    <td class="num">@prev.ValueDate.ToString("dd/MM/yy")</td>
                    <td class="num">@prev.Balance.ToString("N1")</td>
                }
            </tr>
        </tbody>
    </table>

    <h2 class="mt-3">נוכחי</h2>
    <form method="post">
        <input type="hidden" asp-for="Type" />
        <div class="row g-3">
            <div class="col-sm-3">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control num" placeholder="---" />
            </div>
            <div class="col-sm-3">
                <label asp-for="Amount" class="form-label"></label>
                <input asp-for="Amount" class="form-control num" step="0.1" autofocus />
                <span asp-validation-for="Amount" class="text-danger small"></span>
            </div>
            <div class="col-sm-3">
                <label asp-for="Date" class="form-label"></label>
                <input asp-for="Date" type="date" class="form-control" />
            </div>
            <div class="col-sm-3">
                <label asp-for="ValueDate" class="form-label"></label>
                <input asp-for="ValueDate" type="date" class="form-control" />
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-4">
            <button class="btn btn-primary" name="another" value="true">שמור - עוד אחד</button>
            <button class="btn btn-outline-primary" name="another" value="false">שמור וחזור לתפריט</button>
            <a class="btn btn-outline-secondary" asp-action="Index">ביטול</a>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
