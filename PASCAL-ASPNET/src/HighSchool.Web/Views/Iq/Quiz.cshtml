@model HighSchool.Web.Modules.Iq.Quiz
@{
    ViewData["Title"] = "תרגול";
    var round = Model.Round;
}

@if (round is null)
{
    <div class="page-title"><h1>תוצאות</h1></div>
    <div class="panel" style="max-width: 30rem">
        <dl class="row mb-3">
            <dt class="col-8">מספר תשובות נכונות</dt><dd class="col-4 num">@Model.Right</dd>
            <dt class="col-8">מספר תשובות לא נכונות</dt><dd class="col-4 num">@Model.Wrong</dd>
            <dt class="col-8">אחוזי הצלחה</dt><dd class="col-4 num">@Model.Percent%</dd>
        </dl>
        <div class="d-flex gap-2">
            <form method="post" asp-action="Start"><button class="btn btn-primary">עוד תרגול</button></form>
            <form method="post" asp-action="Stop"><button class="btn btn-outline-secondary">סיום</button></form>
        </div>
    </div>
}
else
{
    <div class="page-title">
        <h1>תרגיל @(Model.Current + 1) <small class="text-muted fw-normal">מתוך @Model.Items.Count</small></h1>
        <span class="chip">@round.Subject</span>
    </div>
    <div class="panel" style="max-width: 46rem">
        <p class="text-muted mb-1">מושג:</p>
        <p class="fs-3 fw-bold">@round.Term</p>

        <form method="post" asp-action="Answer" class="d-grid gap-2">
            @for (var i = 1; i <= round.Options.Count; i++)
            {
                var css = round.Answer is null ? "btn-outline-primary"
                    : i == round.CorrectOption ? "btn-success"
                    : i == round.Answer ? "btn-danger" : "btn-outline-secondary";
                <button class="btn @css text-start" name="option" value="@i" disabled="@(round.Answer is not null)" accesskey="@i">
                    <span class="mono fw-bold">@i.</span> @round.Options[i - 1]
                </button>
            }
        </form>

        @if (round.Answer is not null)
        {
            <div class="alert @(round.IsCorrect ? "alert-success" : "alert-danger") mt-3 mb-2">
                @(round.IsCorrect ? "* * * התשובה נכונה * * *" : $"* * * התשובה לא נכונה * * * התשובה הנכונה היא - {round.CorrectOption} * * *")
            </div>
            <form method="post" asp-action="Next"><button class="btn btn-primary" autofocus>המשך</button></form>
        }
        <form method="post" asp-action="Stop" class="mt-3"><button class="btn btn-link btn-sm p-0">9 - סיום</button></form>
    </div>
}
@section Scripts {
    <script>
        // Keys 1-4 answer, as in the original.
        document.addEventListener("keydown", (e) => {
            const b = document.querySelector(`button[name=option][value="${e.key}"]:not([disabled])`);
            if (b) b.click();
        });
    </script>
}
